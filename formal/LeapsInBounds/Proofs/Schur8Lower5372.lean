theorem cert_len : cert.length = 5372 := by decide

/-- The witness coloring: the color of the integer `i`. -/
def colorOf (i : ℕ) : Fin 8 := cert.getD (i - 1) 0

/-- Bitmask of one color class: bit `j` of `maskOf k` is set iff the integer
`j + 1` has color `k`. Built from `cert` inside Lean, so the data lives in
exactly one place. -/
def maskOf (k : ℕ) : ℕ :=
  cert.foldr (fun c acc => (if c.val = k then 1 else 0) + 2 * acc) 0

/-- `Nat.testBit` of a fold-built bitmask reads off the list element directly:
the head of the list lands in bit 0, each step shifts by one. -/
theorem testBit_mask (l : List (Fin 8)) (k : ℕ) :
    ∀ j, j < l.length →
      Nat.testBit (l.foldr (fun c acc => (if c.val = k then 1 else 0) + 2 * acc) 0) j
      = decide ((l.getD j 0).val = k) := by
  induction l with
  | nil => intro j hj; exact absurd hj (Nat.not_lt_zero _)
  | cons c l ih =>
    intro j hj
    rw [List.foldr_cons]
    cases j with
    | zero =>
      by_cases h : c.val = k <;>
        simp [h, Nat.testBit_zero, Nat.add_mul_mod_self_left, List.getD_cons_zero]
    | succ j =>
      have hj' : j < l.length := by simp only [List.length_cons] at hj; omega
      rw [Nat.testBit_succ]
      by_cases h : c.val = k
      · have hd : ((1:ℕ) + 2 * l.foldr (fun c acc => (if c.val = k then 1 else 0) + 2 * acc) 0) / 2
            = l.foldr (fun c acc => (if c.val = k then 1 else 0) + 2 * acc) 0 := by omega
        rw [if_pos h, hd, ih j hj', List.getD_cons_succ]
      · have hd : ((0:ℕ) + 2 * l.foldr (fun c acc => (if c.val = k then 1 else 0) + 2 * acc) 0) / 2
            = l.foldr (fun c acc => (if c.val = k then 1 else 0) + 2 * acc) 0 := by omega
        rw [if_neg h, hd, ih j hj', List.getD_cons_succ]

/-- Bit membership: integer `i` has color `k` iff bit `i - 1` of `maskOf k`
is set (valid whenever `i - 1` is an index of `cert`). -/
theorem mem_bit (k i : ℕ) (hj : i - 1 < cert.length) :
    Nat.testBit (maskOf k) (i - 1) = decide (colorOf i = k) := by
  simp only [maskOf, colorOf]
  rw [testBit_mask cert k (i - 1) hj]
  rfl

/-- The kernel-checked certificate: every color class is sum-free within
`1..5372`. For each `x` in the class, no `y` with `x + y` also in the class:
`(m <<< x) &&& m` has bit `x + y - 1` set iff both `y` and `x + y` are members. -/
def sumFreeMask (m : ℕ) : Bool :=
  (List.range' 1 5372).all fun x => !Nat.testBit m (x - 1) || ((m <<< x) &&& m) == 0

theorem cert_ok : (List.range 8).all (fun k => sumFreeMask (maskOf k)) = true := by
  decide

/-- Main theorem: the Chen-Zhu-Long certificate shows S(8) ≥ 5372. -/
theorem schur8_lower_5372 : LeapsInBounds.Schur.LowerBound 8 5372 := by
  refine ⟨colorOf, fun mono => ?_⟩
  obtain ⟨x, y, hx, hy, hxy, hcxy, hcz⟩ := mono
  have hsf := cert_ok
  rw [List.all_eq_true] at hsf
  have hxsf := hsf (colorOf x) (List.mem_range.mpr (colorOf x).isLt)
  rw [sumFreeMask, List.all_eq_true] at hxsf
  have hxb := hxsf x (List.mem_range'.mpr ⟨x - 1, by omega⟩)
  have hcl : cert.length = 5372 := cert_len
  -- bit x-1 of the mask is set (x is in the class), so the disjunct fails
  have hbx : Nat.testBit (maskOf (colorOf x)) (x - 1) = true := by
    rw [mem_bit _ x (by rw [hcl]; omega)]
    simp
  rw [hbx, Bool.not_true, Bool.false_or] at hxb
  have hand : ((maskOf (colorOf x) <<< x) &&& maskOf (colorOf x)) = 0 := by
    simpa using hxb
  -- bit x+y-1 of both (mask <<< x) and mask is set
  have ht1 : Nat.testBit (maskOf (colorOf x) <<< x) (x + y - 1) = true := by
    rw [Nat.testBit_shiftLeft, show x + y - 1 - x = y - 1 by omega]
    have hyb := mem_bit (colorOf x) y (by rw [hcl]; omega)
    rw [hyb]
    have hle : x ≤ x + y - 1 := by omega
    simp [hcxy, hle]
  have ht2 : Nat.testBit (maskOf (colorOf x)) (x + y - 1) = true := by
    rw [mem_bit _ (x + y) (by rw [hcl]; omega)]
    simp [hcz]
  have hcontra : Nat.testBit ((maskOf (colorOf x) <<< x) &&& maskOf (colorOf x)) (x + y - 1) = true := by
    rw [Nat.testBit_and, ht1, ht2]; simp
  rw [hand, Nat.zero_testBit] at hcontra
  exact absurd hcontra (by simp)

end LeapsInBounds.Proofs.Schur8Lower5372

